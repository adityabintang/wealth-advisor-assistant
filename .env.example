# Copy to .env and adjust. Everything is optional: without an LLM the system
# runs fully offline and uses template narratives.

# --- Optional LLM narrative (provider-agnostic, via LangChain init_chat_model) ---
# Supported examples: openai | anthropic | google_genai | ollama  (empty = disabled)
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=20
# Provide the API key expected by your provider package, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Paths (defaults shown) ---
# WA_CONFIG_PATH=config/thresholds.yaml
# WA_DATA_DIR=data
# WA_LOG_DIR=logs
# WA_MEMORY_PATH=.state/memory.sqlite
